# Copy this file to .env and fill in your own values.
# Never commit a real .env file.

# standalone: one Filen account, custom WebDAV username/password
# proxy: each WebDAV login is a Filen account
WEBDAV_MODE=standalone

# Host port published by compose. Container still listens on 1900.
WEBDAV_PUBLISH_PORT=1900

# Inside the container these are already set. Keep HTTPS off unless you terminate TLS here.
WEBDAV_HOST=0.0.0.0
WEBDAV_PORT=1900
WEBDAV_HTTPS=false
WEBDAV_AUTH_MODE=basic
WEBDAV_DISABLE_LOGGING=false

# Optional cluster worker count. Leave empty to use a single process.
# WEBDAV_THREADS=2

# WebDAV login used by clients in standalone mode.
WEBDAV_USERNAME=change-me-webdav-user
WEBDAV_PASSWORD=change-me-webdav-password

# Filen account used in standalone mode.
# Leave FILEN_2FA empty if the account does not use 2FA.
FILEN_EMAIL=your-filen-email@example.com
FILEN_PASSWORD=change-me-filen-password
FILEN_2FA=

# Optional SDK temp directory. Default is /data/tmp/filen-sdk
# FILEN_TMP_PATH=/data/tmp/filen-sdk
